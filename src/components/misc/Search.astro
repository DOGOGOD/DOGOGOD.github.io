---
import { baseUrl } from "@utils/url-utils";
import { i18n } from "astro:config/client";
import i18nit from "@i18n/translation";

interface SearchResult {
  url: string;
  meta: { title: string };
  excerpt: string;
}

const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const t = i18nit(currentLang);

const translations = {
  placeholder: t("search.placeholder"),
  loading: t("search.loading"),
  error: t("search.error"),
  noresult: t("search.noresult")
};
const fakeResult: SearchResult[] = [
	{
		url: baseUrl("/"),
		meta: {
			title: "This Is a Fake Search Result",
		},
		excerpt:
			"Because the search cannot work in the <mark>dev</mark> environment.",
	},
	{
		url: baseUrl("/"),
		meta: {
			title: "If You Want to Test the Search",
		},
		excerpt: "Try running <mark>pnpm build && pnpm preview</mark> instead.",
  }
]
const searchConfig = JSON.stringify({
  isDev: import.meta.env.DEV,
  fakeResult,
  translations,
});
---
<div
  id="search-modal"
  class="fixed inset-0 z-[20000] opacity-0 pointer-events-none"
  role="dialog"
  aria-modal="true"
  aria-labelledby="search-dialog-title"
  aria-hidden="true"
  data-search-config={searchConfig}
  hidden
  inert
>
  <div class="absolute inset-0 modal-backdrop opacity-0" aria-hidden="true"></div>

  <div class="fixed inset-0 flex items-start justify-center p-4 pt-[25vh]">
    <div class="search-modal-content bg-[var(--bg-color)] rounded-xl shadow-xl w-full max-w-2xl border border-[var(--button-border-color)] overflow-hidden scale-80 transition-all duration-300 opacity-0 flex flex-col max-h-[40vh]">
      <h2 id="search-dialog-title" class="sr-only">{t("search.dialogLabel")}</h2>
      <div class="flex items-center p-4 border-b border-[var(--button-border-color)]">
        <svg class="w-5 h-5 text-[var(--text-color-70)] mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <input 
          type="text" 
          id="search-input"
          aria-label={t("search.placeholder")}
          placeholder={t("search.placeholder")+"..."}
          class="w-full bg-transparent border-0 focus:ring-0 focus:outline-none  text-[var(--text-color)]"
        />
        <button id="close-search" type="button" class="ml-2 p-2 text-[var(--text-color-70)] rounded-lg hover:bg-[var(--button-hover-color)] active:bg-[var(--button-hover-color)]" aria-label={t("search.close")}>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <div id="search-results" class="overflow-y-auto flex-grow" aria-live="polite" aria-atomic="false" aria-busy="false">
        <div class="p-8 text-center text-[var(--text-color-70)]">
          <p>{t("search.placeholder")}</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
type SearchModalWindow = Window & {
  __searchModalAbort?: AbortController;
};

function initSearchModal() {
  const searchButton = document.getElementById('search-button');
  const searchModal = document.getElementById('search-modal');
  const closeSearch = document.getElementById('close-search');
  const searchInput = document.getElementById('search-input');
  const modalBackdrop = searchModal?.firstElementChild;
  const modalContent = searchModal?.querySelector('.search-modal-content');

  if (!searchButton || !searchModal || !(searchModal instanceof HTMLElement)) return;

  const searchWindow = window as SearchModalWindow;
  searchWindow.__searchModalAbort?.abort();
  const controller = new AbortController();
  const { signal } = controller;
  searchWindow.__searchModalAbort = controller;

  let closeTimer: number | undefined;

  const openModal = () => {
    window.clearTimeout(closeTimer);
    searchModal.hidden = false;
    searchModal.inert = false;
    searchModal.setAttribute('aria-hidden', 'false');
    searchModal.classList.remove('opacity-0', 'pointer-events-none');
    void searchModal.offsetHeight;
    requestAnimationFrame(() => {
      modalBackdrop?.classList.remove('opacity-0');
      modalBackdrop?.classList.add('show');
      modalContent?.classList.remove('scale-80', 'opacity-0');
      modalContent?.classList.add('scale-100');
    });
    if (searchInput instanceof HTMLElement) searchInput.focus();
  };

  const closeModal = (restoreFocus = true) => {
    requestAnimationFrame(() => {
      modalBackdrop?.classList.add('opacity-0');
      modalBackdrop?.classList.remove('show');
      modalContent?.classList.add('scale-80', 'opacity-0');
      modalContent?.classList.remove('scale-100');
    });
    closeTimer = window.setTimeout(() => {
      searchModal.classList.add('opacity-0', 'pointer-events-none');
      searchModal.setAttribute('aria-hidden', 'true');
      searchModal.inert = true;
      searchModal.hidden = true;
      if (restoreFocus) searchButton.focus();
    }, 300);
  };

  searchButton.addEventListener('click', openModal, { signal });
  closeSearch?.addEventListener('click', () => closeModal(), { signal });
  searchModal.addEventListener('click', (e) => {
    if (!(e.target instanceof Node) || !modalContent?.contains(e.target)) closeModal();
  }, { signal });
  document.addEventListener('keydown', (e) => {
    if (searchModal.hidden) return;
    if (e.key === 'Escape') {
      e.preventDefault();
      closeModal();
      return;
    }

    if (e.key === 'Tab') {
      const focusable = Array.from(
        searchModal.querySelectorAll<HTMLElement>(
          'button:not([disabled]), input:not([disabled]), a[href], [tabindex]:not([tabindex="-1"])'
        )
      ).filter((element) => !element.hidden);
      const first = focusable[0];
      const last = focusable.at(-1);
      if (!first || !last) return;
      if (!document.activeElement || !searchModal.contains(document.activeElement)) {
        e.preventDefault();
        (e.shiftKey ? last : first).focus();
        return;
      }
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  }, { signal });

  signal.addEventListener('abort', () => {
    window.clearTimeout(closeTimer);
  }, { once: true });
}

document.addEventListener('astro:page-load', initSearchModal);
</script>


<style>
  @keyframes backdropFadeIn {
    0% {
      opacity: 0;
      backdrop-filter: blur(0px);
    }
    100% {
      opacity: 1;
      backdrop-filter: blur(2px);
    }
  }
  
  @keyframes backdropFadeOut {
    0% {
      opacity: 1;
      backdrop-filter: blur(2px);
    }
    100% {
      opacity: 0;
      backdrop-filter: blur(0px);
    }
  }
  
  .modal-backdrop {
    background-color: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(0px);
    transition: opacity 0.3s ease-out;
  }
  
  .modal-backdrop.show {
    animation: backdropFadeIn 0.3s ease-out forwards;
  }
  
  .modal-backdrop:not(.show) {
    animation: backdropFadeOut 0.3s ease-out forwards;
  }
  
  #search-input::-webkit-input-placeholder {
    color: var(--text-color-70);
  }
  
  #search-input::-moz-placeholder {
    color: var(--text-color-70);
  }
</style>

<script>
interface SearchResultData {
  url: string;
  meta: { title: string };
  excerpt: string;
}

interface PagefindSearchResult {
  data: () => Promise<SearchResultData>;
}

type PagefindApi = {
  search: (query: string) => Promise<{ results: PagefindSearchResult[] }>;
};

type PagefindSearchWindow = Window & {
  pagefind?: PagefindApi;
  pagefindLoading?: boolean;
  __pagefindSearchAbort?: AbortController;
};

function initPagefindSearch() {
  const searchInput = document.getElementById('search-input');
  const searchResults = document.getElementById('search-results');
  const searchModal = document.getElementById('search-modal');
  
  if (
    !(searchInput instanceof HTMLInputElement)
    || !(searchResults instanceof HTMLElement)
    || !(searchModal instanceof HTMLElement)
  ) return;

  const searchWindow = window as PagefindSearchWindow;
  searchWindow.__pagefindSearchAbort?.abort();
  const controller = new AbortController();
  const { signal } = controller;
  searchWindow.__pagefindSearchAbort = controller;

  const config = JSON.parse(searchModal.dataset.searchConfig || '{}') as {
    isDev?: boolean;
    fakeResult?: SearchResultData[];
    translations?: Record<string, string>;
  };
  const messages = config.translations ?? {};
  let searchTimeout: number | undefined;
  let requestId = 0;

  const setBusy = (busy: boolean) => {
    searchResults.setAttribute('aria-busy', String(busy));
  };

  const setMessage = (message: string, isError = false, busy = false) => {
    setBusy(busy);
    searchResults.replaceChildren();
    const wrapper = document.createElement('div');
    wrapper.className = `p-8 text-center ${isError ? 'text-red-500' : 'text-[var(--text-color-70)]'}`;
    const paragraph = document.createElement('p');
    paragraph.textContent = message;
    wrapper.append(paragraph);
    searchResults.append(wrapper);
  };

  const appendExcerpt = (container: HTMLElement, excerpt: string) => {
    const template = document.createElement('template');
    template.innerHTML = excerpt;
    template.content.querySelectorAll('*').forEach((element) => {
      if (element.tagName !== 'MARK') {
        element.replaceWith(document.createTextNode(element.textContent ?? ''));
      }
    });
    container.append(template.content);
  };

  const displayResults = (results: SearchResultData[]) => {
    setBusy(false);
    searchResults.replaceChildren();
    if (results.length === 0) {
      setMessage(messages.noresult ?? 'No results found.');
      return;
    }

    results.forEach((result) => {
      const url = new URL(result.url, window.location.origin);
      if (url.origin !== window.location.origin) return;

      const item = document.createElement('div');
      item.className = 'p-4 border-b border-[var(--button-border-color)] hover:bg-[var(--button-hover-color)]';
      const link = document.createElement('a');
      link.href = `${url.pathname}${url.search}${url.hash}`;
      link.className = 'block no-underline';
      const title = document.createElement('h3');
      title.className = 'text-lg font-semibold text-[var(--text-color)] mb-2';
      title.textContent = result.meta.title;
      const excerpt = document.createElement('p');
      excerpt.className = 'text-[var(--text-color-70)] text-sm';
      appendExcerpt(excerpt, result.excerpt);
      link.append(title, excerpt);
      item.append(link);
      searchResults.append(item);
    });
  };

  const performSearch = async (query: string) => {
    const currentRequest = ++requestId;
    setBusy(true);
    if (config.isDev) {
      displayResults(config.fakeResult ?? []);
      return;
    }

    if (!searchWindow.pagefind) {
      const isLoading = searchWindow.pagefindLoading === true;
      setMessage(
        isLoading
          ? (messages.loading ?? 'Loading search index')
          : (messages.error ?? 'Search is unavailable'),
        !isLoading,
        isLoading
      );
      return;
    }

    try {
      const searchResultsData = await searchWindow.pagefind.search(query);
      const results = await Promise.all(
        searchResultsData.results.slice(0, 20).map((result) => result.data())
      );
      if (currentRequest !== requestId || signal.aborted) return;
      displayResults(results);
    } catch (error) {
      if (currentRequest !== requestId || signal.aborted) return;
      console.error('Search failed:', error);
      setMessage(messages.error ?? 'Search failed', true);
    }
  };

  const runCurrentQuery = () => {
    const query = searchInput.value.trim();
    if (query) void performSearch(query);
  };

  searchInput.addEventListener('input', (e) => {
    const query = (e.currentTarget as HTMLInputElement).value.trim();
    window.clearTimeout(searchTimeout);
    requestId += 1;
    setBusy(query.length > 0);

    searchTimeout = window.setTimeout(() => {
      if (query.length > 0) {
        void performSearch(query);
      } else {
        setMessage(messages.placeholder ?? 'Enter keywords to search');
      }
    }, 300);
  }, { signal });

  document.addEventListener('pagefind-ready', runCurrentQuery, { signal });
  document.addEventListener('pagefind-error', () => {
    if (searchInput.value.trim()) {
      setMessage(messages.error ?? 'Search failed', true);
    } else {
      setBusy(false);
    }
  }, { signal });

  signal.addEventListener('abort', () => {
    window.clearTimeout(searchTimeout);
    requestId += 1;
  }, { once: true });
}

document.addEventListener('astro:page-load', initPagefindSearch);
</script>


<style is:global>
mark {
  background-color: #ffeb3b00;
  color: var(--link-color);
  padding: 0 2px;
  font-weight: 600;
}
</style>
