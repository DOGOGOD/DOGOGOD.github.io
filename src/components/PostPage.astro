---
import { blogCoverUrl} from '@utils/url-utils'
import PostCard from '@components/PostCard.astro';
import type { BlogEntryWithLocaleStatus } from '@utils/content-utils';

interface PostPageData {
  data: BlogEntryWithLocaleStatus[];
}

interface Props {
  page: PostPageData;
  offset?: number;
}

const { page, offset = 0 } = Astro.props;

---
{page.data.slice(offset).map((entry: BlogEntryWithLocaleStatus) => (
        <PostCard
            entry={entry}
            title={entry.data.title}
            description={entry.data.description}
            image={blogCoverUrl(entry.data.image, entry.id)}
            pubDate={entry.data.pubDate}
            url={entry.id}
            fallback={entry.isFallback}>
        </PostCard>
))}
