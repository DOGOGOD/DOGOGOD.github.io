---
import i18nit from '@i18n/translation';
import type { ResearchWork } from '@/types/research';

interface Props extends ResearchWork {
  lang: string;
}

const { title, titleEn, description, descriptionEn, authors, venue, year,
  paperUrl, githubUrl, projectUrl, lang } = Astro.props;
const t = i18nit(lang);
const isEnglish = lang === 'en';
const links = [
  { label: t('projects.paper'), url: paperUrl },
  { label: 'GitHub', url: githubUrl },
  { label: t('projects.website'), url: projectUrl },
].filter((link) => link.url);
---

<article class="research-work">
  {(venue || year) && <p class="research-meta">{[venue, year].filter(Boolean).join(' · ')}</p>}
  <h3>{isEnglish && titleEn ? titleEn : title}</h3>
  {authors && <p class="research-authors">{authors}</p>}
  <p class="research-description">{isEnglish && descriptionEn ? descriptionEn : description}</p>
  {links.length > 0 && (
    <ul class="research-links">
      {links.map(({ label, url }) => (
        <li><a href={url} target="_blank" rel="noopener noreferrer">{label}<span aria-hidden="true"> ↗</span></a></li>
      ))}
    </ul>
  )}
</article>

<style>
  .research-work { padding: 1.5rem 0; border-top: 1px solid var(--button-border-color); overflow-wrap: anywhere; }
  h3 { margin: 0; font-size: 1.25rem; font-weight: 700; line-height: 1.5; color: var(--text-color); }
  .research-meta { margin: 0 0 0.6rem; font-size: 0.8rem; color: var(--text-color-70); }
  .research-authors, .research-description { margin: 0.75rem 0 0; font-size: 0.9rem; line-height: 1.8; color: var(--text-color-70); }
  .research-links { display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem; margin: 0.75rem 0 0; padding: 0; list-style: none; }
  .research-links a { display: inline-flex; align-items: center; gap: 0.35rem; min-height: 44px; color: var(--text-color); font-size: 0.875rem; text-decoration: underline; text-underline-offset: 0.3em; text-decoration-color: var(--button-border-color); }
  .research-links a:hover { text-decoration-color: var(--link-color); }
  .research-links a:focus-visible { outline: 2px solid var(--link-color); outline-offset: 4px; border-radius: 2px; }
</style>
