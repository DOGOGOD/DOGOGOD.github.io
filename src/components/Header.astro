---
import { Icon } from "astro-icon/components"
import { profileConfig, siteConfig } from "@/config"
import ThemeIcon from "./control/ThemeIcon.astro"
import RandomReadButton from "./control/RandomReadButton.astro"
import { baseUrl } from "@utils/url-utils"
import { getBlogEntrySort } from "@utils/content-utils"

import { i18n } from "astro:config/client";
import i18nit from '@i18n/translation'
import { getRelativeLocaleUrl } from '@utils/url-utils';

const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const t = i18nit(currentLang);
const isEnglish = currentLang === 'en';


// 获取当前页面在不同语言下的路径
const getLocalePath = (path: string, targetLocale: string) => {
  const currentPath = Astro.url.pathname;
  const defaultLocale = i18n?.defaultLocale || "zh-cn";
  
  // 移除当前语言前缀
  let basePath = currentPath;
  if (currentLang && currentLang !== defaultLocale) {
    basePath = currentPath.replace(`/${currentLang}`, "") || "/";
  }
  
  // 添加目标语言前缀（默认语言不需要前缀）
  if (targetLocale && targetLocale !== defaultLocale) {
    return `/${targetLocale}${basePath}`;
  }
  
  return basePath;
};

const indexPage = getRelativeLocaleUrl(currentLang, "/");
const archivesPage = getRelativeLocaleUrl(currentLang, "/archives/");
const projectsPage = getRelativeLocaleUrl(currentLang, "/projects/");
const aboutPage = getRelativeLocaleUrl(currentLang, "/about/");

const normalizePath = (path: string) => path.replace(/\/+$/, '') || '/';
const allRandomPostUrls = (await getBlogEntrySort(currentLang)).map((post) =>
  getRelativeLocaleUrl(currentLang, `/blog/${post.id}/`)
);
const currentPath = normalizePath(Astro.url.pathname);
const otherPostUrls = allRandomPostUrls.filter((url) => normalizePath(url) !== currentPath);
const randomPostUrls = otherPostUrls.length > 0 ? otherPostUrls : allRandomPostUrls;

let introPage : string;

if (profileConfig.indexPage) {
    introPage = profileConfig.indexPage;
} else {
    introPage = import.meta.env.BASE_URL;
}
---

<!-- header -->
<div id="main-header" class="fixed top-0 left-0 right-0 z-50 transition-transform duration-300 ease-in-out md:relative md:translate-y-0">
<div class="header-inner flex items-center pt-2 md:py-4 text-[var(--text-color)] max-w-[var(--header-width)] mx-auto">
    <!-- logo -->
    <div class="pr-2 sm:pr-4 py-2 z-30 header-logo">
        <a href={ indexPage } >
            <span class="text-2xl sm:text-3xl font-bold hover:opacity-60 transition-opacity">{ siteConfig.title }</span>
        </a>
    </div>
    
    <!-- tools -->
    <div class="header-tools ml-auto flex gap-1 sm:gap-2 pl-2 sm:pl-4 py-2 justify-end z-30">
        <!-- Search -->
        <button id="search-button" type="button" class="flex items-center justify-center w-10 h-10 hover:bg-[var(--button-hover-color)] active:scale-90 rounded-lg hover:text-current border border-[var(--button-border-color)] transition-all duration-300" aria-label={isEnglish ? 'Search' : '搜索'}>
            <Icon name="fa6-solid:magnifying-glass" class="w-4 h-4" />
        </button>
        <!-- Dark Mode -->
        <ThemeIcon class="flex items-center justify-center w-10 h-10 hover:bg-[var(--button-hover-color)] rounded-lg hover:text-current active:scale-90 border border-[var(--button-border-color)] transition-all duration-300"/>
        <!-- RSS -->
        <!-- <a href="/rss.xml" target="_blank" class="flex items-center justify-center w-10 h-10 hover:bg-[var(--button-hover-color)] active:scale-90 rounded-lg hover:text-current border border-[var(--button-border-color)] transition-all duration-300">
            <Icon name="simple-icons:rss" class="w-4 h-4" />
        </a> -->
        <!-- Language Switcher -->
        <div class="relative">
            <button id="language-button" type="button" class="flex items-center justify-center w-10 h-10 hover:bg-[var(--button-hover-color)] active:scale-90 rounded-lg hover:text-current border border-[var(--button-border-color)] transition-all duration-300" aria-label={isEnglish ? 'Switch language' : '切换语言'} aria-controls="language-menu" aria-expanded="false">
                <Icon name="fa6-solid:globe" class="w-4 h-4" />
            </button>
            
          <!-- Language Dropdown Menu -->
          <div id="language-menu" class="hidden absolute right-0 mt-2 min-w-40 bg-[var(--bg-color)] border border-[var(--button-border-color)] rounded-lg shadow-lg z-50" aria-hidden="true">
              <div class="py-1">
                  <!-- 中文链接 -->
                  <a href={getLocalePath("/", "zh-cn")} class=`grid grid-cols-[1rem_1fr_1rem] items-center gap-2 mx-2 my-1 px-2 py-2 text-base leading-6 rounded whitespace-nowrap ${
                    currentLang === "zh-cn" ? "bg-[var(--button-hover-color)]" : "hover:bg-[var(--button-hover-color)]"}`>
                    <span class="inline-flex items-center justify-center w-4 h-4" aria-hidden="true">
                      {currentLang === "zh-cn" ? <Icon name="fa6-solid:circle" class="w-2 h-2" /> : ""}
                    </span>
                    <span class="text-center">简体中文</span>
                    <span class="w-4 h-4" aria-hidden="true"></span>
                  </a>
                  <!-- 英文链接 -->
                  <a href={getLocalePath("/", "en")} class=`grid grid-cols-[1rem_1fr_1rem] items-center gap-2 mx-2 my-1 px-2 py-2 text-base leading-6 rounded whitespace-nowrap ${
                    currentLang === "en" ? "bg-[var(--button-hover-color)]" : "hover:bg-[var(--button-hover-color)]"}`>
                    <span class="inline-flex items-center justify-center w-4 h-4" aria-hidden="true">
                      {currentLang === "en" ? <Icon name="fa6-solid:circle" class="w-2 h-2" /> : ""}
                    </span>
                    <span class="text-center">English</span>
                    <span class="w-4 h-4" aria-hidden="true"></span>
                  </a>
              </div>
          </div>
        </div>
        <div class="relative md:hidden">
          <!-- Mobile Menu -->
          <button id="mobile-menu-button" type="button" class="flex items-center justify-center w-10 h-10 hover:bg-[var(--button-hover-color)] active:scale-90 rounded-lg hover:text-current border border-[var(--button-border-color)] transition-all duration-300" aria-label={isEnglish ? 'Open menu' : '打开菜单'} aria-controls="mobile-menu-container" aria-expanded="false">
              <Icon name="fa6-solid:align-justify" class="w-4 h-4" />
          </button>
              
        </div>
        <RandomReadButton
          urls={randomPostUrls}
          label={t("randomRead.title")}
          ariaLabel={t("randomRead.ariaLabel")}
        />
    </div>
</div>
</div>

    <!-- nav_bar -->
    <div id="nav-bar" class="hidden md:flex absolute left-1/2 top-0 transform -translate-x-1/2  justify-center items-center text-lg font-bold my-5 z-100">
        <div id="nav-bar-list" class="transition relative z-10 flex max-w-max flex-1 items-center justify-center p-2 backdrop-blur rounded-xl bg-[var(--bg-color)]/20 border border-[var(--bg-color)]">
          <!-- 首页链接 -->
          <a href={ indexPage } class={`transition-colors rounded-lg px-3 py-1 mx-1 hover:text-current ${
              Astro.url.pathname === indexPage 
                  ? 'bg-[var(--button-hover-color)]' 
                  : 'hover:bg-[var(--button-hover-color)]'
              }`}>
              {t("header.home")}
          </a>
          <!-- 归档链接 -->
          <a href={ archivesPage } class={`transition-colors rounded-lg px-3 py-1 mx-1 hover:text-current ${
              Astro.url.pathname === archivesPage
                  ? 'bg-[var(--button-hover-color)]'
                  : 'hover:bg-[var(--button-hover-color)]'
              }`}>
              {t("header.archive")}
          </a>
          <!-- 项目链接 -->
          <a href={ projectsPage } class={`transition-colors rounded-lg px-3 py-1 mx-1 hover:text-current ${
              Astro.url.pathname === projectsPage
                  ? 'bg-[var(--button-hover-color)]'
                  : 'hover:bg-[var(--button-hover-color)]'
              }`}>
              {t("header.projects")}
          </a>
          <!-- 关于链接 -->
          <a href={ aboutPage } class={`transition-colors rounded-lg px-3 py-1 mx-1 hover:text-current ${
              Astro.url.pathname === aboutPage
                  ? 'bg-[var(--button-hover-color)]'
                  : 'hover:bg-[var(--button-hover-color)]'
              }`}>
              {t("header.about")}
          </a>
        </div>
    </div>
<!-- Mobile Menu -->
<div id="mobile-menu-container" class="fixed inset-0 z-[20000] hidden" role="dialog" aria-modal="true" aria-label={isEnglish ? 'Navigation menu' : '导航菜单'} aria-hidden="true" inert>
    <div id="mobile-menu-overlay" class="absolute inset-0 bg-black/60 backdrop-blur-sm opacity-0 transition-opacity duration-300 ease-in-out"></div>
    
    <div id="mobile-menu-drawer" class="absolute top-0 left-0 bottom-0 w-[70%] max-w-[300px] bg-[var(--bg-color)] shadow-2xl transform -translate-x-full transition-transform duration-300 ease-in-out flex flex-col">
        
        <div class="flex items-center justify-between p-5 border-b border-[var(--button-border-color)]">
            <span class="text-xl font-bold header-logo">{ siteConfig.title }</span>
            <button id="mobile-menu-close" type="button" class="w-10 h-10 flex items-center justify-center rounded-lg hover:bg-[var(--button-hover-color)] transition-colors" aria-label={currentLang === 'en' ? 'Close menu' : '关闭菜单'}>
                <Icon name="fa6-solid:xmark" class="w-5 h-5" />
            </button>
        </div>

        <nav class="flex flex-col py-4 px-2">
            <a href={ indexPage } class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-[var(--button-hover-color)] hover:text-[var(--link-color)] transition-colors active:bg-[var(--button-hover-color)] active:text-[var(--link-color)]">
                <Icon name="fa6-solid:house" class="w-4 h-4 opacity-70" />
                <span>{t("header.home")}</span>
            </a>
            <a href={ archivesPage } class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-[var(--button-hover-color)] hover:text-[var(--link-color)] transition-colors active:bg-[var(--button-hover-color)] active:text-[var(--link-color)]">
                <Icon name="fa6-solid:book-bookmark" class="w-4 h-4 opacity-70" />
                <span>{t("header.archive")}</span>
            </a>
            <a href={ projectsPage } class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-[var(--button-hover-color)] hover:text-[var(--link-color)] transition-colors active:bg-[var(--button-hover-color)] active:text-[var(--link-color)]">
                <Icon name="fa6-solid:diagram-project" class="w-4 h-4 opacity-70" />
                <span>{t("header.projects")}</span>
            </a>
            <a href={ aboutPage } class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-[var(--button-hover-color)] hover:text-[var(--link-color)] transition-colors active:bg-[var(--button-hover-color)] active:text-[var(--link-color)]">
                <Icon name="fa6-solid:user" class="w-4 h-4 opacity-70" />
                <span>{t("header.about")}</span>
            </a>
        </nav>

        <div class="mt-auto p-5 border-t border-[var(--button-border-color)] flex gap-1 text-sm opacity-70">
             <!-- <a href={getLocalePath("/", "zh-cn")} class="text-sm opacity-70 active:text-[var(--link-color)]">简体中文</a>
             <a href={getLocalePath("/", "en")} class="text-sm opacity-70 active:text-[var(--link-color)]">English</a> -->
             © {new Date().getFullYear()} <a class="link-line" target="_self" href={introPage}>{profileConfig.name}</a>.
        </div>
    </div>
</div>

<style is:global>
.header-logo {
  font-family: "EB Garamond", cursive;
  letter-spacing: 1px;
}
  /* 移动端 (小于 776px) 的毛玻璃和阴影 */
  @media (max-width: 775px) {
    #main-header {
      /* 背景使用带透明度的变量颜色，配合 blur */
      background-color: color-mix(in srgb, var(--bg-color) 70%, transparent);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid color-mix(in srgb, var(--button-border-color) 10%, transparent);
    }

    .header-inner {
      width: 96vw;
      max-width: 96vw;
    }

    .header-inner .header-logo,
    .header-inner .header-logo > a {
      display: flex;
      align-items: center;
    }

    .header-inner .header-logo {
      flex: 1 1 auto;
      justify-content: center;
      min-width: 0;
      padding-left: 0;
      padding-right: 0;
    }

    .header-inner .header-logo > a {
      width: 100%;
      justify-content: center;
    }

    .header-inner .header-logo span {
      font-size: clamp(1.875rem, 6vw, 2.25rem);
      line-height: 1;
    }
  }

  @media (max-width: 400px) {
    .header-inner {
      width: calc(100vw - 0.5rem);
      max-width: calc(100vw - 0.5rem);
    }

    .header-inner .header-logo {
      height: 2.25rem;
      padding: 0;
      letter-spacing: 0.5px;
    }

    .header-inner .header-logo span {
      font-size: clamp(1.75rem, 8vw, 1.875rem);
    }

    .header-tools {
      flex-shrink: 0;
      gap: 0.0625rem;
      padding-left: 0;
    }

    .header-tools button {
      width: 2.25rem;
      min-width: 2.25rem;
      height: 2.25rem;
    }

    .header-tools .random-read-button {
      width: 2.375rem;
      min-width: 2.375rem;
      height: 2.25rem;
    }
  }

</style>

<script>
type BlogNavigationWindow = Window & {
  __mobileNavAbort?: AbortController;
  __blogNavObserver?: IntersectionObserver;
  __mobileHeaderResizeObserver?: ResizeObserver;
};

function initMobileNav() {
  const menuButton = document.getElementById('mobile-menu-button');
  const closeButton = document.getElementById('mobile-menu-close');
  const container = document.getElementById('mobile-menu-container');
  const overlay = document.getElementById('mobile-menu-overlay');
  const drawer = document.getElementById('mobile-menu-drawer');
  const navBar = document.getElementById('nav-bar');
  const navBarList = document.getElementById('nav-bar-list');
  const header = document.getElementById('main-header');

  if (!menuButton || !container) return;

  const blogWindow = window as BlogNavigationWindow;
  blogWindow.__mobileNavAbort?.abort();
  blogWindow.__blogNavObserver?.disconnect();
  blogWindow.__mobileHeaderResizeObserver?.disconnect();

  const controller = new AbortController();
  const { signal } = controller;
  blogWindow.__mobileNavAbort = controller;
  document.body.style.overflow = '';

  let closeTimer: number | undefined;
  let headerResizeObserver: ResizeObserver | undefined;

  const syncMobileHeaderHeight = () => {
    if (!header) return;
    const headerHeight = Math.ceil(header.getBoundingClientRect().height);
    document.documentElement.style.setProperty('--mobile-header-height', `${headerHeight}px`);
  };

  if (header) {
    syncMobileHeaderHeight();
    if ('ResizeObserver' in window) {
      headerResizeObserver = new ResizeObserver(syncMobileHeaderHeight);
      headerResizeObserver.observe(header);
      blogWindow.__mobileHeaderResizeObserver = headerResizeObserver;
    }
    window.addEventListener('resize', syncMobileHeaderHeight, { signal });
  }

  function openMenu() {
    window.clearTimeout(closeTimer);
    container.classList.remove('hidden');
    container.inert = false;
    container.setAttribute('aria-hidden', 'false');
    menuButton.setAttribute('aria-expanded', 'true');
    requestAnimationFrame(() => {
      overlay?.classList.add('opacity-100');
      drawer?.classList.remove('-translate-x-full');
    });
    document.body.style.overflow = 'hidden';
    closeButton?.focus();
  }

  function finishClosingMenu(restoreFocus: boolean) {
    container.classList.add('hidden');
    container.inert = true;
    container.setAttribute('aria-hidden', 'true');
    menuButton.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    if (restoreFocus && menuButton.isConnected) menuButton.focus();
  }

  function closeMenu(restoreFocus = true, immediately = false) {
    window.clearTimeout(closeTimer);
    overlay?.classList.remove('opacity-100');
    drawer?.classList.add('-translate-x-full');

    if (immediately) {
      finishClosingMenu(restoreFocus);
      return;
    }
    closeTimer = window.setTimeout(() => {
      finishClosingMenu(restoreFocus);
    }, 300);
  }

  menuButton.addEventListener('click', openMenu, { signal });
  closeButton?.addEventListener('click', () => closeMenu(), { signal });
  overlay?.addEventListener('click', () => closeMenu(), { signal });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !container.classList.contains('hidden')) {
      closeMenu();
      return;
    }

    if (event.key === 'Tab' && !container.classList.contains('hidden') && drawer) {
      const focusable = Array.from(drawer.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
      ));
      const first = focusable[0];
      const last = focusable.at(-1);
      if (!first || !last) return;
      if (!document.activeElement || !drawer.contains(document.activeElement)) {
        event.preventDefault();
        (event.shiftKey ? last : first).focus();
        return;
      }
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    }
  }, { signal });

  drawer?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => closeMenu(false), { signal });
  });

  const desktopQuery = window.matchMedia('(min-width: 768px)');
  let navObserver: IntersectionObserver | undefined;

  const resetDesktopNav = () => {
    navBar?.classList.remove('fixed');
    navBarList?.classList.add('border-[var(--bg-color)]');
    navBarList?.classList.remove(
      'border-[var(--button-border-color)]',
      'shadow-[0_4px_12px_var(--shadow-color)]'
    );
  };

  const configureDesktopNav = () => {
    navObserver?.disconnect();
    navObserver = undefined;
    blogWindow.__blogNavObserver = undefined;

    if (!desktopQuery.matches) {
      resetDesktopNav();
      return;
    }

    if (!container.classList.contains('hidden')) closeMenu(false, true);
    if (!header || !navBar || !navBarList) return;

    navObserver = new IntersectionObserver(([entry]) => {
      const isDetached = !entry.isIntersecting;
      navBar.classList.toggle('fixed', isDetached);
      navBarList.classList.toggle('border-[var(--bg-color)]', !isDetached);
      navBarList.classList.toggle('border-[var(--button-border-color)]', isDetached);
      navBarList.classList.toggle('shadow-[0_4px_12px_var(--shadow-color)]', isDetached);
    }, { threshold: 0 });
    navObserver.observe(header);
    blogWindow.__blogNavObserver = navObserver;
  };

  desktopQuery.addEventListener('change', configureDesktopNav, { signal });
  configureDesktopNav();

  signal.addEventListener('abort', () => {
    window.clearTimeout(closeTimer);
    navObserver?.disconnect();
    headerResizeObserver?.disconnect();
    document.body.style.overflow = '';
  }, { once: true });
}

document.addEventListener('astro:page-load', initMobileNav);
</script>
<script>
type LanguageMenuWindow = Window & {
  __languageMenuAbort?: AbortController;
};

function initLanguageMenu() {
  const languageButton = document.getElementById('language-button');
  const languageMenu = document.getElementById('language-menu');
  const mobileMenu = document.getElementById('mobile-menu-container');

  if (!languageButton || !languageMenu) return;

  const languageWindow = window as LanguageMenuWindow;
  languageWindow.__languageMenuAbort?.abort();
  const controller = new AbortController();
  const { signal } = controller;
  languageWindow.__languageMenuAbort = controller;

  const closeLanguageMenu = () => {
    languageMenu.classList.add('hidden');
    languageMenu.setAttribute('aria-hidden', 'true');
    languageButton.setAttribute('aria-expanded', 'false');
  };

  languageButton.addEventListener('click', (e) => {
    e.stopPropagation();
    mobileMenu?.classList.add('hidden');
    const willOpen = languageMenu.classList.contains('hidden');
    languageMenu.classList.toggle('hidden', !willOpen);
    languageMenu.setAttribute('aria-hidden', String(!willOpen));
    languageButton.setAttribute('aria-expanded', String(willOpen));
  }, { signal });

  document.addEventListener('click', (event) => {
    if (
      event.target instanceof Node &&
      !languageButton.contains(event.target) &&
      !languageMenu.contains(event.target)
    ) {
      closeLanguageMenu();
    }
  }, { signal });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !languageMenu.classList.contains('hidden')) {
      closeLanguageMenu();
      languageButton.focus();
    }
  }, { signal });
}
document.addEventListener('astro:page-load', initLanguageMenu);
</script>


{import.meta.env.PROD && 
<script is:inline define:vars={{ scriptUrl: baseUrl('/pagefind/pagefind.js') }}>
async function loadPagefind() {
  if (window.pagefind && typeof window.pagefind.search === 'function') {
    return window.pagefind;
  }

  if (window.__pagefindPromise) return window.__pagefindPromise;
  window.pagefindLoading = true;

  window.__pagefindPromise = (async () => {
    const pagefind = await import(scriptUrl);
    await pagefind.options({ excerptLength: 20 });
    window.pagefind = pagefind;
    document.dispatchEvent(new CustomEvent('pagefind-ready'));
    return pagefind;
  })();

  try {
    return await window.__pagefindPromise;
  } catch (error) {
    console.error('Pagefind 加载失败:', error);
    window.__pagefindPromise = undefined;
    document.dispatchEvent(new CustomEvent('pagefind-error'));
    throw error;
  } finally {
    window.pagefindLoading = false;
  }
}

function attachSearchListener() {
  const btn = document.getElementById('search-button');
  if (!btn || btn.dataset.pagefindBound === 'true') return;
  btn.dataset.pagefindBound = 'true';
  btn.addEventListener('click', () => {
    loadPagefind().catch(() => {});
  });
}

document.addEventListener('astro:page-load', attachSearchListener);
</script>
}
