---
import MainPageLayout from '@layouts/MainPageLayout.astro';
import PostPage from '@components/PostPage.astro';
import Navi from '@components/control/Navi.astro';
import FabMenu from '@components/control/FabMenu.astro';

import { getBlogEntrySort } from '@utils/content-utils';
import { getRelativeLocaleUrl } from '@utils/url-utils';
import { formatFullDate } from '@/utils/time';
import { siteConfig, profileConfig } from '@/config';
import { i18n } from 'astro:config/client';
import type { CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';

const { page } = Astro.props;

const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const isEn = currentLang === 'en';

export const getStaticPaths = (async ({ paginate }) => {
  function createPinTopSort() {
    return (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => {
      const pinTopA = a.data.pinTop ?? 0;
      const pinTopB = b.data.pinTop ?? 0;
      if (pinTopA > 0 && pinTopB > 0) return pinTopB - pinTopA;
      if (pinTopA > 0) return -1;
      if (pinTopB > 0) return 1;
      return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
    };
  }

  const paths = [];
  for (const locale of i18n?.locales ?? []) {
    const localeCode = typeof locale === 'string' ? locale : locale.path;
    const localeParam = localeCode === i18n?.defaultLocale ? undefined : localeCode;
    const blogEntries = await getBlogEntrySort(localeParam, undefined, createPinTopSort());
    const paginatedPaths = paginate(blogEntries, {
      pageSize: siteConfig.pageSize,
      params: { locale: localeParam },
    });
    paths.push(...paginatedPaths);
  }
  return paths;
}) satisfies GetStaticPaths;

const isFirstPage = page.currentPage === 1;
const pageTitle = `${siteConfig.title} - ${siteConfig.subTitle}`;
const archivesUrl = getRelativeLocaleUrl(currentLang, '/archives/');
const month = new Date().getMonth() + 1;
const seasonKey = month >= 3 && month <= 5
  ? 'spring'
  : month >= 6 && month <= 8
    ? 'summer'
    : month >= 9 && month <= 11
      ? 'autumn'
      : 'winter';
const seasonalGreetings = {
  zh: {
    spring: { title: '春日安好', message: '愿新一季的阅读，带来清醒与从容。' },
    summer: { title: '盛夏安好', message: '愿你在漫长白昼里，读到片刻清凉。' },
    autumn: { title: '新秋安好', message: '愿每一次翻页，都有所收获。' },
    winter: { title: '冬日安好', message: '愿灯下的文字，带来一点温暖。' },
  },
  en: {
    spring: { title: 'Spring greetings', message: 'May the new season bring clear and thoughtful reading.' },
    summer: { title: 'High summer greetings', message: 'May these pages offer a quiet pause in the long daylight.' },
    autumn: { title: 'Autumn greetings', message: 'May every page leave something worth keeping.' },
    winter: { title: 'Winter greetings', message: 'May these words bring a little warmth to the reading hour.' },
  },
} as const;
const seasonalGreeting = seasonalGreetings[isEn ? 'en' : 'zh'][seasonKey];
---

<MainPageLayout title={pageTitle} lang={currentLang}>
  {
    isFirstPage && (
      <div class="home-page mx-auto w-full max-w-[var(--page-width)] px-0 pb-8 pt-16 sm:pt-20">
        <section class="author-intro text-center" aria-labelledby="author-name">
          <img
            src={profileConfig.avatar}
            alt={profileConfig.name}
            class="author-avatar mx-auto h-24 w-24 rounded-full object-cover"
            width="96"
            height="96"
            decoding="async"
            fetchpriority="high"
            onerror="this.style.display='none'"
          />
          <h1
            id="author-name"
            class="author-name mt-6 text-4xl font-semibold tracking-tight sm:text-5xl"
          >
            {profileConfig.name}
          </h1>
          <p class="author-description mx-auto mt-4 max-w-xl text-base leading-8 sm:text-lg">
            {isEn ? profileConfig.intro.en : profileConfig.intro.zh}
          </p>
        </section>

        <section class="article-index mt-12 sm:mt-14" aria-labelledby="article-index-title">
          <h2 id="article-index-title" class="sr-only">
            {isEn ? 'Articles' : '文章'}
          </h2>

          {page.data.length > 0 ? (
            <ol class="article-list">
              {page.data.map((entry) => (
                <li>
                  <a
                    class="article-entry"
                    href={getRelativeLocaleUrl(currentLang, `/blog/${entry.id}/`)}
                  >
                    <div class="article-copy">
                      <h3>{entry.data.title}</h3>
                      {entry.data.description && <p>{entry.data.description}</p>}
                      <div class="article-meta">
                        <time datetime={entry.data.pubDate.toISOString()}>
                          {formatFullDate(entry.data.pubDate, currentLang)}
                        </time>
                        {entry.data.category && (
                          <span class="article-category">#{entry.data.category}</span>
                        )}
                      </div>
                    </div>
                    <span class="read-label">
                      {isEn ? 'Read' : '阅读全文'}
                      <span class="read-arrow" aria-hidden="true">›</span>
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          ) : (
            <p class="article-empty">{isEn ? 'No articles yet.' : '文章正在整理中。'}</p>
          )}

          <div class="archive-link-wrap">
            <a class="archive-link" href={archivesUrl}>
              {isEn ? 'Browse the archive' : '查看全部文章'}
            </a>
          </div>
        </section>

        <section class="seasonal-greeting" aria-labelledby="seasonal-greeting-title">
          <h2 id="seasonal-greeting-title">{seasonalGreeting.title}</h2>
          <p>{seasonalGreeting.message}</p>
        </section>
      </div>
    )
  }

  {
    !isFirstPage && (
      <div class="mx-auto w-full max-w-[var(--page-width)] pt-12">
        <h2 class="mb-6 text-2xl font-bold" style="color: var(--text-color);">
          {isEn ? 'Articles' : '文章'}
        </h2>
      </div>
    )
  }

  {
    !isFirstPage && (
      <>
        <PostPage page={page} />
        <Navi page={page} />
      </>
    )
  }
  <FabMenu showBackBottom={true} />
</MainPageLayout>

<style>
  .home-page {
    color: var(--text-color);
  }

  .author-avatar {
    border: 1px solid var(--button-border-color);
    box-shadow:
      0 0 0 5px var(--bg-color),
      0 0 0 6px var(--button-border-color);
  }

  .author-name {
    color: var(--text-color);
    font-family: "EB Garamond", "LXGW Bright Medium", serif;
  }

  .author-description {
    color: var(--text-color-70);
    text-wrap: balance;
  }

  .article-list {
    display: grid;
    gap: 1rem;
  }

  .article-list > li {
    min-width: 0;
  }

  .article-entry {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 2rem;
    min-height: 10rem;
    overflow: hidden;
    border: 1px solid var(--button-border-color);
    border-radius: 0.75rem;
    padding: 1.5rem 1.65rem;
    background: var(--button-hover-color);
    background: color-mix(in srgb, var(--button-hover-color) 72%, var(--bg-color));
    color: inherit;
    box-shadow: 0 8px 24px -22px rgba(33, 31, 28, 0.5);
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .article-entry::before {
    position: absolute;
    inset-block: 1.25rem;
    left: 0;
    width: 3px;
    border-radius: 0 3px 3px 0;
    background: var(--link-color);
    content: '';
    opacity: 0;
    transform: scaleY(0.45);
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  .article-entry:hover {
    background: var(--button-hover-color);
    border-color: color-mix(in srgb, var(--link-color) 56%, var(--button-border-color));
    box-shadow: 0 14px 32px -22px rgba(33, 31, 28, 0.55);
    transform: translateY(-2px);
  }

  .article-entry:hover::before {
    opacity: 0.85;
    transform: scaleY(1);
  }

  .article-entry:active {
    transform: translateY(0) scale(0.995);
  }

  .article-entry:focus-visible {
    outline: 2px solid var(--link-color);
    outline-offset: 4px;
  }

  .article-copy {
    min-width: 0;
  }

  .article-copy h3 {
    color: var(--text-color);
    font-size: clamp(1.25rem, 3vw, 1.55rem);
    font-weight: 600;
    line-height: 1.45;
    text-wrap: balance;
  }

  .article-copy p {
    margin-top: 0.55rem;
    max-width: 58ch;
    color: var(--text-color-70);
    font-size: 0.95rem;
    line-height: 1.75;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 1rem;
    margin-top: 1.05rem;
    color: var(--text-color-70);
    font-size: 0.8rem;
    line-height: 1.35;
  }

  .article-meta time {
    white-space: nowrap;
  }

  .article-category {
    color: var(--link-color);
    white-space: nowrap;
  }

  .read-label {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--link-color);
    font-size: 0.86rem;
    line-height: 1;
    white-space: nowrap;
  }

  .read-arrow {
    font-family: system-ui, sans-serif;
    font-size: 1.25rem;
    line-height: 0.8;
    transition: transform 180ms ease;
  }

  .article-entry:hover .read-arrow {
    transform: translateX(0.2rem);
  }

  .article-empty {
    border-block: 1px solid var(--button-border-color);
    padding: 3rem 1rem;
    color: var(--text-color-70);
    text-align: center;
  }

  .archive-link-wrap {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }

  .archive-link {
    border-bottom: 1px solid var(--link-color);
    padding: 0.25rem 0;
    color: var(--link-color);
    font-size: 0.9rem;
    transition: opacity 180ms ease;
  }

  .archive-link:hover {
    opacity: 0.72;
  }

  .archive-link:focus-visible {
    outline: 2px solid var(--link-color);
    outline-offset: 4px;
  }

  .seasonal-greeting {
    display: grid;
    justify-items: center;
    margin-top: clamp(4rem, 8vw, 6rem);
    padding: clamp(3rem, 6vw, 4.5rem) 1rem 1rem;
    border-top: 1px solid var(--button-border-color);
    text-align: center;
  }

  .seasonal-greeting h2 {
    margin: 0;
    color: var(--text-color);
    font-family: "LXGW Bright Medium", "EB Garamond", serif;
    font-size: clamp(1.4rem, 2.4vw, 1.65rem);
    font-weight: 500;
    letter-spacing: 0.03em;
    line-height: 1.35;
  }

  .seasonal-greeting p {
    max-width: 34rem;
    margin: 0.65rem 0 0;
    color: var(--text-color-70);
    font-size: 0.88rem;
    line-height: 1.8;
  }

  :global([data-theme='dark']) .article-entry {
    box-shadow: 0 10px 28px -22px rgba(0, 0, 0, 0.75);
  }

  :global([data-theme='dark']) .article-entry:hover {
    box-shadow: 0 16px 34px -22px rgba(0, 0, 0, 0.9);
  }

  @media (max-width: 767px) {
    .home-page {
      padding-top: calc(var(--mobile-header-height, 4rem) + 1.5rem);
    }
  }

  @media (max-width: 640px) {
    .home-page {
      width: min(90vw, var(--page-width));
    }

    .article-entry {
      grid-template-columns: 1fr;
      gap: 1.15rem;
      min-height: 0;
      padding: 1.3rem 1.2rem;
    }

    .article-meta {
      gap: 0.4rem 0.8rem;
    }

    .read-label {
      margin-left: auto;
    }

    .seasonal-greeting {
      margin-top: 3.5rem;
      padding-top: 2.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .article-entry,
    .article-entry::before,
    .read-arrow,
    .archive-link {
      transition: none;
    }

    .article-entry:hover,
    .article-entry:active {
      transform: none;
    }
  }
</style>
