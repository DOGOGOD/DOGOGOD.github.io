---
import MainPageLayout from '@layouts/MainPageLayout.astro'
import ArchivePanel from '@components/ArchivePanel.svelte'
import FabMenu from '@components/control/FabMenu.astro'
import { siteConfig } from '@/config'
import { getBlogEntrySort } from '@utils/content-utils'
import i18nit from '@i18n/translation'
import { i18n } from "astro:config/client";



const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const t = i18nit(currentLang);

export async function getStaticPaths() {
	const locales = i18n?.locales || [i18n?.defaultLocale || 'zh-cn'];
	return locales.map(locale => ({ params: { locale: locale == i18n?.defaultLocale ? undefined : (locale as string) } }));
}

// 获取所有博客文章并按发布日期降序排序
const allBlogPosts = await getBlogEntrySort(currentLang);
const archivePosts = allBlogPosts.map(({ id, isFallback, data }) => ({
	id,
	isFallback: Boolean(isFallback),
	data: {
		title: data.title,
		pubDate: data.pubDate,
		category: data.category,
	},
}));

const pageTitle = t("header.archive") + " - " + siteConfig.title;
---

<MainPageLayout title={pageTitle} lang={currentLang}>
    <ArchivePanel
        client:load
        sortedPosts={archivePosts}
        currentLang={currentLang}
        defaultLocale={i18n!.defaultLocale}
    />
    <FabMenu showBackBottom={true} />
</MainPageLayout>
