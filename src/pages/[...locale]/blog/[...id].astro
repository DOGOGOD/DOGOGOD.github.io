---
import { siteConfig, licenseConfig } from '@/config'
import MainPageLayout from '@layouts/MainPageLayout.astro'
import Markdown from '@components/misc/Markdown.astro'
import ImageModule from '@components/misc/ImageModule.astro'
import FabMenu from '@components/control/FabMenu.astro'
import TOC from '@components/TOC.svelte'
import LicenseCard from '@components/misc/LicenseCard.astro'
import BlogNavi from '@components/control/BlogNavi.astro'

import { render } from 'astro:content'
import { i18n } from 'astro:config/client'
import i18nit from '@i18n/translation'
import { Icon } from 'astro-icon/components'

import { blogCoverUrl } from '@/utils/url-utils'
import { formatFullDate } from '@/utils/time'
import { getBlogEntrySort } from '@utils/content-utils'
import { getRelativeLocaleUrl } from '@utils/url-utils'

const currentLang = Astro.currentLocale || i18n!.defaultLocale
const t = i18nit(currentLang)

export async function getStaticPaths() {
    const locales = i18n?.locales || [i18n?.defaultLocale]
    const paths = []

    for (const locale of locales) {
        const blogEntries = await getBlogEntrySort(locale)

        for (let i = 0; i < blogEntries.length; i++) {
            const entry = blogEntries[i]
            const next = i > 0 ? blogEntries[i - 1] : null
            const prev = i < blogEntries.length - 1 ? blogEntries[i + 1] : null

            paths.push({
                params: {
                    locale: locale === i18n?.defaultLocale ? undefined : locale,
                    id: entry.id
                },
                props: { entry, prev, next }
            })
        }
    }

    return paths
}

const { entry, prev, next } = Astro.props
const { Content, headings, remarkPluginFrontmatter } = await render(entry)
const tocHeadings = headings.filter((heading) => {
    const headingText = heading.text.trim()
    const headingSlug = heading.slug.toLowerCase()
    return !/^(目录|contents|table of contents)$/i.test(headingText)
        && !['目录', 'contents', 'table-of-contents'].includes(headingSlug)
})

const pageTitle = `${entry.data.title} - ${siteConfig.title}`
const image = blogCoverUrl(entry.data.image, entry.id)
const category = entry.data.category || ''
const categoryLabels: Record<string, { zh: string; en: string; zhType: string; enType: string }> = {
    life: { zh: '生活随笔', en: 'Life', zhType: '随想', enType: 'Essay' },
    guide: { zh: '阅读指南', en: 'Guide', zhType: '文档', enType: 'Reference' }
}
const isEnglish = currentLang === 'en'
const categoryMeta = categoryLabels[category]
const categoryLabel = categoryMeta
    ? (isEnglish ? categoryMeta.en : categoryMeta.zh)
    : (category || (isEnglish ? 'Writing' : '文章'))
const categoryType = categoryMeta
    ? (isEnglish ? categoryMeta.enType : categoryMeta.zhType)
    : (isEnglish ? 'Article' : '文章')
const categoryUrl = getRelativeLocaleUrl(
    currentLang,
    category ? `/archives/?category=${encodeURIComponent(category)}` : '/archives/'
)
---

<MainPageLayout title={pageTitle} lang={currentLang} description={entry.data.description}>
    <div class="reading-progress" aria-hidden="true"></div>

    <section class="article-layout">
        <header class="chapter-opening">
            <a
                href={categoryUrl}
                class="chapter-category"
            >
                {categoryLabel} <span aria-hidden="true">·</span> {categoryType}
            </a>

            <h1 class="chapter-title">{entry.data.title}</h1>

            {entry.data.description && (
                <div class="chapter-lead">
                    <p>{entry.data.description}</p>
                    {entry.data.epigraphAuthor && <cite>{entry.data.epigraphAuthor}</cite>}
                </div>
            )}

            <div class="chapter-meta" aria-label={isEnglish ? 'Article information' : '文章信息'}>
                <time datetime={entry.data.pubDate.toISOString()}>
                    {formatFullDate(entry.data.pubDate, currentLang)}
                </time>
                <span>{remarkPluginFrontmatter?.words || 0} {t('pagecard.words')}</span>
                <span>{remarkPluginFrontmatter?.minutes || 0} {t('pagecard.minutes')}</span>
            </div>

            <span class="chapter-mark" aria-hidden="true"></span>
        </header>

        {siteConfig.toc.enable && tocHeadings.length > 0 && (
            <div class="article-toc-slot">
                <TOC headings={tocHeadings} language={currentLang} client:load />
            </div>
        )}

        <article class="article-body">
            {image && (
                <div class="article-cover">
                    <ImageModule src={image} class="h-full w-full object-cover" />
                </div>
            )}

            {entry.data.draft && (
                <div class="article-notice article-notice-danger">
                    <Icon name="fa6-solid:triangle-exclamation" class="mt-0.5 h-4 w-4 shrink-0" />
                    <p>
                        <strong>{t('draftNote.warning')}</strong>
                        {t('draftNote.description')}
                    </p>
                </div>
            )}

            {entry.isFallback && (
                <div class="article-notice article-notice-warning">
                    <Icon name="fa6-solid:circle-info" class="mt-0.5 h-4 w-4 shrink-0" />
                    <p>
                        <strong>{t('langNote.note')}</strong>
                        {t('langNote.description')}
                    </p>
                </div>
            )}

            <Markdown class="article-markdown mb-8">
                <Content />
            </Markdown>

            {licenseConfig.enable && (
                <LicenseCard title={entry.data.title} pubDate={entry.data.pubDate} />
            )}

            {siteConfig.blogNavi.enable && <BlogNavi prev={prev} next={next} />}
        </article>
    </section>

    <FabMenu showBackBottom={true} />
</MainPageLayout>

<style>
    .reading-progress {
        position: fixed;
        inset: 0 0 auto;
        z-index: 70;
        height: 2px;
        background: var(--link-color);
        transform: scaleX(0);
        transform-origin: left center;
        pointer-events: none;
        will-change: transform;
    }

    .article-layout {
        width: var(--page-width);
        margin-inline: auto;
        padding-block: clamp(4rem, 8vw, 6rem) 6rem;
    }

    .chapter-opening {
        width: min(100%, 47.5rem);
        margin: 0 auto clamp(3.5rem, 7vw, 5.5rem);
    }

    .chapter-category {
        display: inline-block;
        color: var(--link-color);
        font-size: 0.95rem;
        letter-spacing: 0.045em;
        text-decoration: none;
        transition: opacity 180ms ease;
    }

    .chapter-category:hover {
        opacity: 0.68;
    }

    .chapter-category:focus-visible {
        outline: 2px solid var(--link-color);
        outline-offset: 0.35rem;
    }

    .chapter-title {
        margin: 1.5rem 0 1.8rem;
        color: var(--text-color);
        font-family: "EB Garamond", "LXGW Bright Medium", serif;
        font-size: clamp(3.45rem, 7vw, 5.35rem);
        font-weight: 400;
        line-height: 1.04;
        letter-spacing: -0.035em;
        text-wrap: balance;
    }

    .chapter-lead {
        max-width: 43rem;
        padding: 0.35rem 0 0.35rem 1.4rem;
        border-left: 3px solid var(--link-color);
        color: var(--text-color);
    }

    .chapter-lead p {
        margin: 0;
        font-size: clamp(1.18rem, 2vw, 1.45rem);
        line-height: 1.7;
        letter-spacing: 0.025em;
    }

    .chapter-lead cite {
        display: block;
        margin-top: 0.55rem;
        color: var(--text-color-70);
        font-size: 0.88rem;
        font-style: normal;
    }

    .chapter-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.65rem 1.5rem;
        margin-top: 2rem;
        color: var(--text-color-70);
        font-size: 0.9rem;
        font-variant-numeric: tabular-nums;
    }

    .chapter-mark {
        display: block;
        width: 3.25rem;
        height: 2px;
        margin-top: 2.7rem;
        background: var(--link-color);
    }

    .article-toc-slot {
        min-width: 0;
    }

    .article-body {
        width: 100%;
        margin-inline: auto;
        min-width: 0;
    }

    .article-cover {
        aspect-ratio: 16 / 9;
        margin-bottom: 3.5rem;
        overflow: hidden;
        border: 1px solid var(--border-color);
    }

    .article-notice {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        margin-bottom: 2rem;
        padding: 1rem;
        border: 1px solid;
        border-radius: 8px;
        font-size: 0.9rem;
        line-height: 1.7;
    }

    .article-notice p {
        margin: 0;
    }

    .article-notice-danger {
        border-color: var(--danger-border-color);
        background: var(--danger-bg-color);
        color: var(--danger-text-color);
    }

    .article-notice-warning {
        border-color: var(--warning-border-color);
        background: var(--warning-bg-color);
        color: var(--warning-text-color);
    }

    @media (max-width: 1179px) {
        .article-layout {
            padding-block: 6.75rem 4.5rem;
        }

        .chapter-opening {
            margin-bottom: 2.75rem;
        }

        .article-toc-slot {
            margin-bottom: 3rem;
        }
    }

    @media (max-width: 639px) {
        .article-layout {
            padding-block: 6.25rem 3.75rem;
        }

        .chapter-title {
            margin-block: 1.15rem 1.5rem;
            font-size: clamp(3rem, 16vw, 4rem);
        }

        .chapter-lead {
            padding-left: 1rem;
        }

        .chapter-meta {
            gap: 0.5rem 1rem;
            margin-top: 1.6rem;
        }

        .chapter-mark {
            margin-top: 2.2rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .reading-progress {
            display: none;
        }

        .chapter-category {
            transition: none;
        }
    }
</style>

<script>
    type ReadingProgressWindow = Window & {
        __readingProgressAbort?: AbortController;
        __readingProgressFrame?: number;
        __readingProgressResizeObserver?: ResizeObserver;
    };

    function initReadingProgress() {
        const runtimeWindow = window as ReadingProgressWindow;
        runtimeWindow.__readingProgressAbort?.abort();
        runtimeWindow.__readingProgressResizeObserver?.disconnect();
        if (runtimeWindow.__readingProgressFrame) {
            cancelAnimationFrame(runtimeWindow.__readingProgressFrame);
        }

        const indicator = document.querySelector<HTMLElement>('.reading-progress');
        if (!indicator) return;

        const controller = new AbortController();
        const { signal } = controller;
        runtimeWindow.__readingProgressAbort = controller;

        let lastScrollTop = Math.max(0, window.scrollY, document.documentElement.scrollTop);
        let lastProgress = 0;

        const update = () => {
            runtimeWindow.__readingProgressFrame = undefined;

            const root = document.documentElement;
            const scrollTop = Math.max(0, window.scrollY, root.scrollTop);
            const viewportHeight = root.clientHeight;
            const scrollHeight = Math.max(root.scrollHeight, document.body.scrollHeight);
            const scrollRange = Math.max(1, scrollHeight - viewportHeight);
            const atBottom = scrollTop + viewportHeight >= scrollHeight - 2;
            const rawProgress = atBottom ? 1 : Math.min(1, scrollTop / scrollRange);

            // Images, external cards and Safari's collapsing toolbar can change the
            // denominator while the reader is still moving down. Only allow the bar
            // to decrease when the document itself was actually scrolled upward.
            const scrolledUp = scrollTop < lastScrollTop - 1;
            const progress = scrolledUp
                ? rawProgress
                : Math.max(lastProgress, rawProgress);

            indicator.style.transform = `scaleX(${progress})`;
            lastScrollTop = scrollTop;
            lastProgress = progress;
        };

        const scheduleUpdate = () => {
            if (runtimeWindow.__readingProgressFrame) return;
            runtimeWindow.__readingProgressFrame = requestAnimationFrame(update);
        };

        window.addEventListener('scroll', scheduleUpdate, { passive: true, signal });
        window.addEventListener('resize', scheduleUpdate, { passive: true, signal });
        window.visualViewport?.addEventListener('resize', scheduleUpdate, { passive: true, signal });

        if ('ResizeObserver' in window) {
            const resizeObserver = new ResizeObserver(scheduleUpdate);
            resizeObserver.observe(document.body);
            const article = document.querySelector('.article-layout');
            if (article) resizeObserver.observe(article);
            runtimeWindow.__readingProgressResizeObserver = resizeObserver;
        }

        document.fonts?.ready.then(() => {
            if (!signal.aborted) scheduleUpdate();
        });

        signal.addEventListener('abort', () => {
            if (runtimeWindow.__readingProgressFrame) {
                cancelAnimationFrame(runtimeWindow.__readingProgressFrame);
                runtimeWindow.__readingProgressFrame = undefined;
            }
            runtimeWindow.__readingProgressResizeObserver?.disconnect();
            runtimeWindow.__readingProgressResizeObserver = undefined;
        }, { once: true });

        update();
    }

    document.addEventListener('astro:page-load', initReadingProgress);
</script>
